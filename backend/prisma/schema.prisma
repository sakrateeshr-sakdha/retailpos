generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  MIXED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

model Shop {
  id                 String          @id @default(uuid())
  name               String          @default("My Grocery Shop")
  address            String?         @default("Main Road, Kerala")
  phone              String?         @default("+91 9876543210")
  gstNumber          String?
  invoicePrefix      String          @default("INV-")
  currency           String          @default("₹")
  upiId              String?         @default("groceryshop@upi")
  receiptFooter      String?         @default("Thank You! Visit Again")
  allowNegativeStock Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  users              User[]
  products           Product[]
  categories         Category[]
  sales              Sale[]
  customers          Customer[]
  stockMovements     StockMovement[]
}

model User {
  id           String    @id @default(uuid())
  shopId       String
  username     String    @unique
  passwordHash String
  name         String
  role         Role      @default(CASHIER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([shopId])
  @@index([username])
}

model Category {
  id          String    @id @default(uuid())
  shopId      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id                 String          @id @default(uuid())
  shopId             String
  categoryId         String?
  name               String
  barcode            String?
  sku                String?
  purchasePrice      Decimal         @default(0) @db.Decimal(10, 2)
  sellingPrice       Decimal         @db.Decimal(10, 2)
  stockQuantity      Decimal         @default(0) @db.Decimal(10, 3)
  unit               String          @default("pcs") // pcs, kg, g, litre, ml, packet, box, bottle
  lowStockThreshold  Decimal         @default(5) @db.Decimal(10, 3)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category           Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems          SaleItem[]
  stockMovements     StockMovement[]

  @@index([shopId])
  @@index([barcode])
  @@index([sku])
  @@index([name])
}

model Sale {
  id             String         @id @default(uuid())
  shopId         String
  userId         String
  customerId     String?
  invoiceNumber  String         @unique
  idempotencyKey String?        @unique
  subtotal       Decimal        @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  paymentMethod  PaymentMethod  @default(CASH)
  status         SaleStatus     @default(COMPLETED)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]

  @@index([shopId])
  @@index([createdAt])
  @@index([customerId])
  @@index([invoiceNumber])
  @@index([idempotencyKey])
}

model SaleItem {
  id            String   @id @default(uuid())
  saleId        String
  productId     String?
  productName   String
  quantity      Decimal  @db.Decimal(10, 3)
  unit          String   @default("pcs")
  unitPrice     Decimal  @db.Decimal(10, 2)
  purchasePrice Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(uuid())
  saleId          String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  cashReceived    Decimal?      @db.Decimal(10, 2)
  changeGiven     Decimal?      @db.Decimal(10, 2)
  referenceNumber String?
  createdAt       DateTime      @default(now())

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model StockMovement {
  id            String       @id @default(uuid())
  shopId        String
  productId     String
  type          MovementType
  quantity      Decimal      @db.Decimal(10, 3)
  previousStock Decimal      @db.Decimal(10, 3)
  newStock      Decimal      @db.Decimal(10, 3)
  reason        String?
  referenceId   String?      // e.g. saleId or adjustment note
  createdAt     DateTime     @default(now())

  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id          String            @id @default(uuid())
  shopId      String
  name        String
  phone       String?
  email       String?
  address     String?
  totalCredit Decimal           @default(0) @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales       Sale[]
  payments    CustomerPayment[]

  @@index([shopId])
  @@index([phone])
  @@index([name])
}

model CustomerPayment {
  id            String        @id @default(uuid())
  customerId    String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  notes         String?
  createdAt     DateTime      @default(now())

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}
